# Databricks SQL Warehouse / Cluster connection
DATABRICKS_HOST=Databricks workspace URL (e.g., https://<your-workspace>.databricks.com)
DATABRICKS_HTTP_PATH=  HTTP path for SQL Warehouse or Cluster (e.g., /sql/1.0/warehouses/<warehouse-id>)
DATABRICKS_TOKEN=   Personal Access Token for authentication (generate in Databricks user settings)

# Delta Share profile (JSON string or file path)


# Database & Table info
DATABASE_NAME=SampleDB
TABLE_NAME=sample_table

# Logging
# JWT
JWT_SECRET=your-strong-secret-key-change-in-production

# Optional test credentials (for generating tokens)
TEST_USERNAME=your-username
TEST_PASSWORD=yourPassword
# Server port
PORT=3000
LOG_LEVEL=info